[Unit]
Description=Qwen3.8-Flash-Next GSQ-RCO Q2_0 llama-server (LRU expert cache PR#27861 + AVX2 Q2_0 + sync fix, dio, 131K) on tailnet
After=network-online.target tailscaled.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/src/llama.cpp-lru-new/build/bin
# 2026-09-21: GPU-resident LRU expert cache (llama.cpp PR #27861, unmerged) on branch lru-new.
# Cache misses are computed by the CPU mul_mat_id (AVX2 Q2_0 kernel), so GGML_OP_OFFLOAD_MIN_BATCH
# must stay at its default: op-offload + cache measured at half speed. 64 slots/layer = ~4 GiB VRAM,
# which forces context down from 262144 to 131072. Measured: decode 34 -> 49-51 t/s (fresh prose),
# 34 -> 44.5 (extractive); output identical to the uncached path. Previous unit: *.bak.*-pre-lru
ExecStart=%h/src/llama.cpp-lru-new/build/bin/llama-server \
  -m %h/ai-models/flashnext-gsq-q2_0/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf \
  --no-warmup -lm dio \
  -ngl 99 -ot ffn_.*_exps=CPU \
  --moe-expert-cache 64 --moe-expert-cache-inserts 2 \
  -fa on -ctk q8_0 -ctv q8_0 -c 131072 -b 4096 -ub 2048 -t 12 -tb 12 \
  --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
  --cache-reuse 256 --jinja --parallel 1 \
  --host __HOST_IP__ --port 8082 \
  --api-key __API_KEY__ \
  --alias qwen3.8-flash-next
# 2026-09-20 hardening: pinned RSS ~34 GiB + PLE page cache; cap keeps a blow-up inside this cgroup.
MemoryMax=52G
MemorySwapMax=0
OOMScoreAdjust=500
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
