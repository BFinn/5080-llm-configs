+// Q2_0: 64 weights per block, one fp16 scale, 2-bit codes packed 4 per byte (little end first),
+// code -> value {0,1,2,3} -> {-1,0,1,2}. One Q2_0 block spans two Q8_0 blocks.
+void ggml_vec_dot_q2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK2_0;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q2_0 * GGML_RESTRICT x = vx;
+    const block_q8_0 * GGML_RESTRICT y = vy;
+
+#if defined(__AVX2__)
+    // Unpack 8 packed bytes -> 32 contiguous int8 codes without per-byte shifts:
+    // zero-extend each byte into a 32-bit lane, spread the even bit-pairs (bits 0-1,4-5) to
+    // lane bytes 0 and 2, the odd bit-pairs (bits 2-3,6-7) to lane bytes 1 and 3, mask to 2 bits.
+    const __m256i m_even = _mm256_set1_epi32(0x33);
+    const __m256i m_odd  = _mm256_set1_epi32(0xCC);
+    const __m256i m_2bit = _mm256_set1_epi32(0x03030303);
+    const __m256i ones   = _mm256_set1_epi8(1);
+    __m256 acc = _mm256_setzero_ps();
+
+    for (int ib = 0; ib < nb; ++ib) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[ib].d);
+        for (int k = 0; k < 2; ++k) {
+            const __m256i b8 = _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *)(x[ib].qs + 8*k)));
+            const __m256i ev = _mm256_and_si256(b8, m_even);
+            const __m256i od = _mm256_and_si256(b8, m_odd);
+            __m256i r = _mm256_or_si256(ev, _mm256_slli_epi32(ev, 12));
+            r = _mm256_or_si256(r, _mm256_or_si256(_mm256_slli_epi32(od, 6), _mm256_slli_epi32(od, 18)));
+            r = _mm256_and_si256(r, m_2bit);
+            const __m256i qx = _mm256_sub_epi8(r, ones);                       // {0..3} -> {-1..2}
+            const __m256i qy = _mm256_loadu_si256((const __m256i *) y[2*ib + k].qs);
+            const __m256  d  = _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y[2*ib + k].d));
+            acc = _mm256_fmadd_ps(d, mul_sum_i8_pairs_float(qx, qy), acc);
+        }
+    }
+
+    *s = hsum_float_8(acc);
+#else
+    ggml_vec_dot_q2_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
